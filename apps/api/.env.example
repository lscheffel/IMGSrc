# Rate Limit Configuration
# Configure o middleware de rate-limit com janela deslizante por host

# Ativa (true) ou desativa (false) o rate-limit
RATE_LIMIT_ENABLED=true

# Janela de tempo em milissegundos (default: 60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000

# Máximo de requests por janela (default: 20)
RATE_LIMIT_MAX_REQUESTS=20

# Allowance adicional para bursts (default: 5)
RATE_LIMIT_BURST=5

# Worker Pool Configuration
# Configure o pool de workers para tasks de scrape e download

# Número mínimo de workers no pool (default: 1)
WORKER_POOL_MIN=1

# Número máximo de workers simultâneos (default: 4)
WORKER_POOL_MAX=4

# Timeout para workers ociosos antes de encerrar (ms, default: 300000 = 5 min)
WORKER_IDLE_TIMEOUT_MS=300000